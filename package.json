{
  "name": "outstanding-pull-requests-action",
  "version": "2.0.0",
  "private": true,
  "description": "Send a Slack message when too many pull requests are merged into one branch but not yet into another.",
  "type": "module",
  "scripts": {
    "build": "ncc build src/index.ts -o dist",
    "lint": "eslint src",
    "typecheck": "tsc",
    "test": "node --test 'src/**/*.test.ts'"
  },
  "engines": {
    "node": ">=24"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fishbrain/outstanding-pull-requests-action"
  },
  "keywords": [
    "pull requests",
    "github",
    "action",
    "actions"
  ],
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/fishbrain/outstanding-pull-requests-action/issues"
  },
  "homepage": "https://github.com/fishbrain/outstanding-pull-requests-action#readme",
  "dependencies": {
    "@actions/core": "3.0.1",
    "@actions/github": "9.1.1",
    "@slack/web-api": "8.4.0"
  },
  "devDependencies": {
    "@fishbrain/eslint-config-base": "6.3.7",
    "@types/node": "24.19.3",
    "@vercel/ncc": "0.45.0",
    "typescript": "7.0.2"
  }
}
